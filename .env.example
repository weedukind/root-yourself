# Lokal: Postgres-Container aus docker/docker-compose.dev.yml (vom Host aus Port 5433).
# Im Web-Container überschreibt docker-compose.dev.yml den Wert mit db:5432.
# Produktion: von der Neon-Integration in Vercel gesetzt.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/rootyourself

# Zugang zu /admin: htpasswd-Datei (bcrypt), Base64-kodiert.
# Erzeugen:  htpasswd -nbB admin 'passwort' | base64 -w0
ADMIN_HTPASSWD_B64=

# Bildspeicher über die S3-API. Lokal setzt docker-compose.dev.yml diese Werte für RustFS.
# Produktion (Cloudflare R2):
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Nur lokal nötig: Pfad-Adressierung und eine vom Browser erreichbare Adresse für Presigned URLs.
# S3_FORCE_PATH_STYLE=true
# S3_PUBLIC_ENDPOINT=http://localhost:9000
# Öffentliche Basis-URL der Bilder (bei R2: eigene Domain am Bucket).
MEDIA_PUBLIC_URL=
